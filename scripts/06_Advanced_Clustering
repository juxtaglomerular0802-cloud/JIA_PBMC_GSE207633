)

cluster30_resolutions <- c(
  0.1,
  0.2,
  0.3,
  0.4
)

cluster30_obj <- recluster_single_cluster(
  object = combined_integrated,
  cluster_id = 30,
  dims_use = 1:10,
  resolutions = cluster30_resolutions,
  nfeatures = 1500
)

cluster30_obj <- save_azimuth_reclustering_results(
  object = cluster30_obj,
  analysis_name = "cluster30_reclustering",
  reduction_name = "cluster30_umap",
  output_directory = output_dir,
  resolution_values = cluster30_resolutions,
  selected_resolution = 0.2,
  sample_col = sample_col,
  azimuth_label_col = azimuth_label_col,
  azimuth_score_col = azimuth_score_col
)


