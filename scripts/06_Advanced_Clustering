# ============================================================
# 최종 celltype별 Azimuth 대표 label proportion 및 score
# ============================================================

final_annotation_summary <- combined_integrated@meta.data %>%
  mutate(
    final_celltype = as.character(final_celltype),
    azimuth_label = as.character(predicted.celltype.l2)
  ) %>%
  count(
    final_celltype,
    azimuth_label,
    name = "n"
  ) %>%
  group_by(final_celltype) %>%
  mutate(
    total_cells = sum(n),
    proportion = n / total_cells
  ) %>%
  arrange(
    final_celltype,
    desc(proportion)
  ) %>%
  ungroup()

write.csv(
  final_annotation_summary,
  file = file.path(
    output_dir,
    "GSE207633_final_celltype_Azimuth_full_distribution.csv"
  ),
  row.names = FALSE
)

final_annotation_top <- final_annotation_summary %>%
  group_by(final_celltype) %>%
  slice_max(
    order_by = n,
    n = 1,
    with_ties = FALSE
  ) %>%
  ungroup() %>%
  rename(
    representative_Azimuth_label = azimuth_label,
    representative_n = n,
    representative_proportion = proportion
  )

write.csv(
  final_annotation_top,
  file = file.path(
    output_dir,
    "GSE207633_final_celltype_Azimuth_annotation_summary.csv"
  ),
  row.names = FALSE
)

final_annotation_top
